<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Hlavní SEO Tagy -->
    <title>Vytvořte si vlastní AZ-Kvíz online | Generátor a šablona</title>
    <meta name="description" content="Vytvořte si vlastní AZ-Kvíz snadno a rychle! Ideální online šablona pro učitele do výuky i skvělá vědomostní hra pro večery s přáteli. Zcela zdarma.">
    <meta name="keywords" content="az kviz, azkviz, az kviz online, azkviz online, az kviz sablona, azkviz sablona, az kviz vytvorit, azkviz vytvorit, vlastni az kviz, vlastni azkviz, az kviz pro ucitele, azkviz do vyuky, az kviz zdarma, generator az kviz, hra s prateli, party hra, spolocenska hra, opakovani uciva, vedomostni soutez">
    <meta name="author" content="Jan Žitník">
    <meta name="robots" content="index, follow">

    <!-- Open Graph (Náhledy pro sdílení na Messengeru, Facebooku, Discordu atd.) -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://azkviz.jzitnik.dev/">
    <meta property="og:title" content="Vytvořte si vlastní AZ-Kvíz | Online generátor zdarma">
    <meta property="og:description" content="Zahrajte si legendární vědomostní hru s přáteli nebo ji využijte jako interaktivní šablonu do výuky. Rychlá příprava, český jazyk.">
    <meta property="og:image" content="https://azkviz.jzitnik.dev/img/homepage.webp">

    <!-- Strukturovaná data pro Google (Rich Snippets) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Generátor vlastního AZ-Kvízu",
      "applicationCategory": "GameApplication, EducationalApplication",
      "url": "https://azkviz.jzitnik.dev",
      "description": "Online generátor a šablona pro tvorbu vlastního AZ-Kvízu. Vhodné pro zábavu s přáteli i jako nástroj pro učitele do výuky.",
      "operatingSystem": "All",
      "inLanguage": "cs",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CZK"
      }
    }
    </script>

    <!-- Analytika -->
    <script defer src="https://analytics.client.jzitnik.dev/script.js" data-website-id="31d7f7d7-725b-4b81-8e85-2a5423c4ed9e"></script>
    <script defer src="https://analytics.client.jzitnik.dev/recorder.js" data-website-id="31d7f7d7-725b-4b81-8e85-2a5423c4ed9e"></script>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
